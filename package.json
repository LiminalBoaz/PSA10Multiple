{
  "name": "slab-scout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phone-first scanner for Pok\u00e9mon cards worth grading: Cardmarket NM English raw prices vs PSA 8/9/10.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "data:contenders": "tsx pipeline/contenders.ts",
    "data:pricecharting": "tsx pipeline/pricecharting.ts",
    "data:cardmarket": "tsx pipeline/cardmarket.ts",
    "data:build": "tsx pipeline/build.ts",
    "data": "npm run data:contenders && npm run data:pricecharting && npm run data:cardmarket && npm run data:build",
    "icons": "tsx pipeline/icons.ts"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "cheerio": "1.2.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1",
    "zod": "4.6.5"
  },
  "packageManager": "npm@11.6.2"
}
